# Default — normalize text files to LF in the repo
* text=auto eol=lf

# Binary files — never apply line-ending conversion
*.jar        binary
*.class      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.svg        text eol=lf
*.zip        binary
*.tar        binary
*.gz         binary
*.war        binary
