# Copy this file to infra/staging/.env.staging. It is intentionally ignored by Git.
# Generate unique staging-only values; never reuse production credentials here.

POSTGRES_DB=helium_staging
POSTGRES_USER=helium_staging
POSTGRES_PASSWORD=replace-with-a-unique-staging-database-password
POSTGRES_PORT=15432

HELIUM_REDIS_PASSWORD=replace-with-a-unique-staging-redis-password
REDIS_PORT=16379

HELIUM_JWT_SECRET=replace-with-a-unique-staging-jwt-secret-at-least-32-characters
HELIUM_TOTP_ENCRYPTION_KEY=replace-with-a-unique-staging-totp-key-at-least-32-characters
HELIUM_API_KEY_PEPPER=replace-with-a-unique-staging-api-key-pepper-at-least-32-characters

HELIUM_HTTP_PORT=18080
HELIUM_WEB_PORT=13000
NEXT_PUBLIC_APP_NAME=HELIUM Staging
NEXT_PUBLIC_HELIUM_API_BASE_URL=http://localhost:18080
NEXT_PUBLIC_HELIUM_WS_BASE_URL=ws://localhost:18080

# The Docker staging overlay forces these safe defaults even if this file changes.
HELIUM_EMAIL_ENABLED=false
HELIUM_MARKET_DATA_LIVE_ENABLED=false
HELIUM_WALLET_CHAIN_MONITOR_ENABLED=false
HELIUM_WALLET_BUILDER_WORKER_ENABLED=false
HELIUM_CUSTODY_SIGNING_WORKER_ENABLED=false
HELIUM_WALLET_BROADCAST_WORKER_ENABLED=false
HELIUM_WALLET_CONFIRMATION_WORKER_ENABLED=false
HELIUM_WALLET_STUCK_MONITOR_ENABLED=false
