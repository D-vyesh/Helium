# =========================================================
# HELIUM LOCAL DEVELOPMENT ENVIRONMENT
# Copy to .env and replace secrets before running.
# Do not commit .env.
# =========================================================

# -------------------------
# APP
# -------------------------

SPRING_PROFILES_ACTIVE=local
HELIUM_ENVIRONMENT=local
HELIUM_HTTP_PORT=8080
HELIUM_SHUTDOWN_TIMEOUT=30s
HELIUM_LOG_LEVEL=INFO

# -------------------------
# AUTH / SECURITY
# -------------------------

# Development only. For production generate at least 64 random characters:
# openssl rand -base64 64
HELIUM_JWT_SECRET=local-development-jwt-secret-change-me-minimum-64-bytes

# Development only. For production generate 32+ random bytes and store in a secret manager:
# openssl rand -base64 32
HELIUM_TOTP_ENCRYPTION_KEY=local-totp-encryption-key-32bytes!!

HELIUM_API_KEY_VERSION=v1

# Development only. For production generate with a CSPRNG and store in Vault/KMS/secrets:
# openssl rand -base64 64
HELIUM_API_KEY_PEPPER=local-development-api-key-pepper-change-me
HELIUM_API_KEY_PREVIOUS_VERSION=
HELIUM_API_KEY_PREVIOUS_PEPPER=
HELIUM_API_KEY_SIGNATURE_TTL=5m
HELIUM_API_KEY_NONCE_TTL=10m
HELIUM_API_KEY_DEFAULT_LIFETIME=90d

# Secrets backend used by the app. Production should use a managed secret provider.
HELIUM_SECRETS_BACKEND=environment
HELIUM_SECRETS_REFRESH_MS=300000

# -------------------------
# POSTGRES
# -------------------------

POSTGRES_DB=helium
POSTGRES_USER=helium
POSTGRES_PASSWORD=helium
POSTGRES_PORT=5432

# Local app process uses localhost. Docker backend uses postgres service DNS via docker-compose.yml.
HELIUM_DB_URL=jdbc:postgresql://localhost:5432/helium
HELIUM_DB_USERNAME=helium
HELIUM_DB_PASSWORD=helium
HELIUM_DB_POOL_SIZE=20
HELIUM_DB_MAX_LIFETIME_MS=1800000

# Production notes:
# - Use managed Postgres or a hardened Postgres cluster.
# - Set HELIUM_DB_URL to the production JDBC URL.
# - Store HELIUM_DB_PASSWORD in a secret manager, not in source control.

# -------------------------
# REDIS
# -------------------------

REDIS_PORT=6379

# Local app process uses localhost. Docker backend uses redis service DNS via docker-compose.yml.
HELIUM_REDIS_HOST=localhost
HELIUM_REDIS_PORT=6379
HELIUM_REDIS_PASSWORD=helium-redis-change-me
HELIUM_REDIS_TIMEOUT=2s

# Production notes:
# - Use managed Redis/Valkey with TLS where available.
# - Generate a strong Redis password in the provider console or secret manager.

# -------------------------
# EMAIL / SMTP
# -------------------------

HELIUM_EMAIL_ENABLED=true
HELIUM_EMAIL_FROM=no-reply@helium.local
HELIUM_EMAIL_FROM_NAME=HELIUM Exchange
HELIUM_EMAIL_BASE_URL=http://localhost:3000

# Local MailHog defaults. Start compose with the mail profile if you want MailHog.
HELIUM_SMTP_HOST=localhost
HELIUM_SMTP_PORT=1025
HELIUM_SMTP_USERNAME=
HELIUM_SMTP_PASSWORD=
HELIUM_SMTP_AUTH=false
HELIUM_SMTP_STARTTLS=false

# Gmail SMTP example for local testing:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password in Google Account > Security > App passwords.
# 3. Put the generated app password in HELIUM_SMTP_PASSWORD.
# HELIUM_EMAIL_FROM=your.address@gmail.com
# HELIUM_SMTP_HOST=smtp.gmail.com
# HELIUM_SMTP_PORT=587
# HELIUM_SMTP_USERNAME=your.address@gmail.com
# HELIUM_SMTP_PASSWORD=your-gmail-app-password
# HELIUM_SMTP_AUTH=true
# HELIUM_SMTP_STARTTLS=true

# Production notes:
# - Prefer Amazon SES, SendGrid, Mailgun, or another transactional email provider.
# - Verify the sending domain and configure SPF, DKIM, and DMARC.
# - Store SMTP credentials in a secret manager.

# -------------------------
# OUTBOX / OBSERVABILITY
# -------------------------

HELIUM_OUTBOX_ENABLED=true
HELIUM_OUTBOX_POLL_INTERVAL_MS=1000
HELIUM_TRACE_SAMPLING_PROBABILITY=0.10
HELIUM_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# Production notes:
# - Send traces to your OpenTelemetry collector endpoint.
# - Replace Grafana admin credentials immediately.

# -------------------------
# BLOCKCHAIN RPC PROVIDERS
# -------------------------

# Comma-separated real RPC endpoints. Use authenticated URLs where required.
# BTC examples:
# HELIUM_BTC_RPC_NODES=http://user:pass@localhost:8332,http://user:pass@backup-bitcoind:8332
# ETH examples:
# HELIUM_ETH_RPC_NODES=https://eth-mainnet.g.alchemy.com/v2/key,https://mainnet.infura.io/v3/key,http://localhost:8545
# SOL examples:
# HELIUM_SOL_RPC_NODES=https://mainnet.helius-rpc.com/?api-key=key,https://api.mainnet-beta.solana.com,http://localhost:8899
HELIUM_BTC_RPC_NODES=
HELIUM_ETH_RPC_NODES=
HELIUM_SOL_RPC_NODES=

HELIUM_WALLET_RPC_FAILURE_THRESHOLD=3
HELIUM_WALLET_RPC_RECOVERY_TIMEOUT_MS=30000
HELIUM_WALLET_RPC_STALE_BLOCK_LAG=6
HELIUM_WALLET_RPC_HEALTH_MONITOR_ENABLED=true
HELIUM_WALLET_RPC_HEALTH_MONITOR_POLL_INTERVAL_MS=30000
HELIUM_WALLET_RPC_CONSISTENCY_MONITOR_ENABLED=true
HELIUM_WALLET_RPC_CONSISTENCY_MONITOR_POLL_INTERVAL_MS=30000
HELIUM_WALLET_RPC_CONSISTENCY_ALLOWED_BLOCK_LAG=3

# Local/dev can use 1 provider. Production should use independent providers and agreement > 1.
HELIUM_WALLET_BLOCKCHAIN_CONSENSUS_MINIMUM_HEALTHY_PROVIDERS=1
HELIUM_WALLET_BLOCKCHAIN_CONSENSUS_MINIMUM_AGREEMENT=1
HELIUM_WALLET_CHAIN_MONITOR_ENABLED=false

# Production notes:
# - BTC: operate your own Bitcoin Core node and at least one independent backup.
# - ETH: use independent providers such as Alchemy, Infura, QuickNode, and/or your own Geth/Nethermind.
# - SOL: use independent providers such as Helius, QuickNode, Triton, and/or your own validator RPC.

# -------------------------
# WALLET WORKERS
# -------------------------

# Keep disabled in normal development until real RPC + custody are configured.
HELIUM_WALLET_BUILDER_WORKER_ENABLED=false
HELIUM_WALLET_BUILDER_POLL_INTERVAL_MS=5000
HELIUM_CUSTODY_SIGNING_WORKER_ENABLED=false
HELIUM_CUSTODY_SIGNING_POLL_INTERVAL_MS=5000
HELIUM_CUSTODY_SIGNING_MAX_RETRIES=5
HELIUM_WALLET_BROADCAST_WORKER_ENABLED=false
HELIUM_WALLET_BROADCAST_POLL_INTERVAL_MS=5000
HELIUM_WALLET_BROADCAST_MAX_RETRIES=5
HELIUM_WALLET_CONFIRMATION_WORKER_ENABLED=false
HELIUM_WALLET_CONFIRMATION_POLL_INTERVAL_MS=15000
HELIUM_WALLET_STUCK_MONITOR_ENABLED=false
HELIUM_WALLET_STUCK_MONITOR_POLL_INTERVAL_MS=600000
HELIUM_WALLET_STUCK_MONITOR_THRESHOLD_MINUTES=60

# -------------------------
# CUSTODY / SIGNING
# -------------------------

# ETH hot/custody source address used for unsigned transaction building.
HELIUM_ETH_CUSTODY_ADDRESS=

# SOL fee payer public key used for unsigned versioned transaction building.
HELIUM_SOL_FEE_PAYER=

# Hashicorp Vault provider settings. Production should provision keys in Vault Transit.
HELIUM_VAULT_ADDRESS=
HELIUM_VAULT_TOKEN=

# Offline custody response inbox for air-gapped/manual signing workflows.
HELIUM_OFFLINE_CUSTODY_RESPONSE_DIRECTORY=

# Production notes:
# - Use AWS KMS, Azure Key Vault, GCP KMS, Hashicorp Vault, or an HSM/custody vendor.
# - HELIUM must only receive signatures, never private keys.

# -------------------------
# COMPLIANCE
# -------------------------

# Contracted sanctions provider. The adapter uses POST /v1/screening/users and
# POST /v1/screening/addresses and expects {"sanctioned": true|false}.
# With no provider configured, screening fails closed and holds withdrawals.
HELIUM_SANCTIONS_BASE_URL=
HELIUM_SANCTIONS_API_TOKEN=

# -------------------------
# BROADCAST
# -------------------------

HELIUM_SOLANA_BROADCAST_SKIP_PREFLIGHT=false
HELIUM_SOLANA_BROADCAST_COMMITMENT=processed

# -------------------------
# MARKET DATA
# -------------------------

HELIUM_MARKET_DATA_LIVE_ENABLED=true
HELIUM_BINANCE_REST_BASE_URL=https://api.binance.com
HELIUM_BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
HELIUM_MARKET_DATA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HELIUM_MARKET_DATA_REST_TIMEOUT=5s
HELIUM_MARKET_DATA_RECONNECT_INITIAL_DELAY=1s
HELIUM_MARKET_DATA_RECONNECT_MAX_DELAY=30s
HELIUM_MARKET_DATA_CACHE_TTL=20s
HELIUM_MARKET_DATA_ORDER_BOOK_LIMIT=100
HELIUM_MARKET_DATA_TRADE_LIMIT=80
HELIUM_MARKET_DATA_CANDLE_LIMIT=240
HELIUM_MARKET_DATA_REST_REFRESH_MS=30000
HELIUM_PRICE_ALERT_EVALUATION_MS=15000

# -------------------------
# FRONTEND
# -------------------------

NEXT_PUBLIC_APP_NAME=HELIUM
NEXT_PUBLIC_HELIUM_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_HELIUM_WS_BASE_URL=ws://localhost:8080
HELIUM_WEB_PORT=3000

# -------------------------
# LOCAL BLOCKCHAIN CERTIFICATION
# DO NOT USE FOR PRODUCTION
# -------------------------

CERT_POSTGRES_PORT=55432
CERT_POSTGRES_DB=helium
CERT_POSTGRES_USER=helium
CERT_POSTGRES_PASSWORD=helium_certification_password

CERT_REDIS_PORT=56379
CERT_REDIS_PASSWORD=helium-cert-redis

CERT_SPRING_PROFILES_ACTIVE=local,certification
CERT_BTC_RPC_USER=helium
CERT_BTC_RPC_PASSWORD=helium_regtest_password
CERT_BTC_RPC_PORT=18443
CERT_ETH_RPC_PORT=18545
CERT_SOL_RPC_PORT=18899
CERT_HELIUM_HTTP_PORT=18080
CERT_MINIMUM_HEALTHY_PROVIDERS=1
CERT_MINIMUM_AGREEMENT=1

# Certification notes:
# - These keys are consumed by docker-compose.blockchain-certification.yml.
# - The backend talks to postgres, redis, bitcoin, anvil, and solana by Docker service name.
# - Minimum provider agreement of 1 is acceptable only for local certification.

# -------------------------
# PRODUCTION PLACEHOLDERS
# Keep commented until deploying.
# -------------------------

# SPRING_PROFILES_ACTIVE=production
# HELIUM_ENVIRONMENT=production
# HELIUM_DB_URL=jdbc:postgresql://<managed-postgres-host>:5432/helium
# HELIUM_DB_USERNAME=<production-db-user>
# HELIUM_DB_PASSWORD=<from-secret-manager>
# HELIUM_REDIS_HOST=<managed-redis-host>
# HELIUM_REDIS_PORT=6379
# HELIUM_REDIS_PASSWORD=<from-secret-manager>
# HELIUM_JWT_SECRET=<openssl-rand-base64-64>
# HELIUM_TOTP_ENCRYPTION_KEY=<openssl-rand-base64-32>
# HELIUM_API_KEY_PEPPER=<openssl-rand-base64-64>
# HELIUM_EMAIL_FROM=no-reply@your-domain.com
# HELIUM_EMAIL_BASE_URL=https://your-domain.com
# HELIUM_SMTP_HOST=<ses-or-sendgrid-smtp-host>
# HELIUM_SMTP_PORT=587
# HELIUM_SMTP_USERNAME=<smtp-user-from-provider>
# HELIUM_SMTP_PASSWORD=<smtp-secret-from-provider>
# HELIUM_SMTP_AUTH=true
# HELIUM_SMTP_STARTTLS=true
# HELIUM_BTC_RPC_NODES=<primary-bitcoin-core-rpc>,<secondary-bitcoin-core-rpc>
# HELIUM_ETH_RPC_NODES=<alchemy-or-infura-url>,<quicknode-url>,<self-hosted-eth-rpc>
# HELIUM_SOL_RPC_NODES=<helius-url>,<quicknode-url>,<self-hosted-sol-rpc>
# HELIUM_WALLET_BLOCKCHAIN_CONSENSUS_MINIMUM_HEALTHY_PROVIDERS=2
# HELIUM_WALLET_BLOCKCHAIN_CONSENSUS_MINIMUM_AGREEMENT=2
# HELIUM_WALLET_CHAIN_MONITOR_ENABLED=true
# HELIUM_ETH_CUSTODY_ADDRESS=<public-custody-eth-address>
# HELIUM_SOL_FEE_PAYER=<public-custody-sol-fee-payer>
# HELIUM_VAULT_ADDRESS=https://vault.your-company.internal
# HELIUM_VAULT_TOKEN=<vault-token-from-runtime-secret>
